{
  "name": "FeederBankDetails",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the feeder"
    },
    "full_legal_name": {
      "type": "string",
      "description": "Full legal name as it appears on bank account"
    },
    "bank_name": {
      "type": "string",
      "description": "Name of the bank"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number or IBAN"
    },
    "swift_bic": {
      "type": "string",
      "description": "SWIFT / BIC code for international transfers"
    },
    "bank_address": {
      "type": "string",
      "description": "Address of the bank branch"
    },
    "account_holder_address": {
      "type": "string",
      "description": "Home address of the account holder"
    },
    "wise_email": {
      "type": "string",
      "description": "Wise (TransferWise) account email, if available"
    },
    "currency": {
      "type": "string",
      "description": "Preferred currency for receiving funds (e.g. USD, EUR, GBP)"
    },
    "additional_notes": {
      "type": "string",
      "description": "Any additional transfer notes or instructions"
    },
    "total_earned_usd": {
      "type": "number",
      "default": 0,
      "description": "Total USD earned from feedings (calculated)"
    },
    "total_paid_usd": {
      "type": "number",
      "default": 0,
      "description": "Total USD already paid out"
    }
  },
  "required": [
    "user_email"
  ]
}